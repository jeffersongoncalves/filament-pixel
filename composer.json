{
    "name": "jeffersongoncalves/filament-pixel",
    "description": "Filament plugin for Meta (Facebook) Pixel — tracking script injection and a Settings Page to manage the Pixel ID directly from your Filament panel, powered by spatie/laravel-settings.",
    "keywords": [
        "jeffersongoncalves",
        "laravel",
        "filament-pixel"
    ],
    "homepage": "https://github.com/jeffersongoncalves/filament-pixel",
    "license": "MIT",
    "authors": [
        {
            "name": "Jefferson Gonçalves",
            "email": "gerson.simao.92@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2|^8.3",
        "jeffersongoncalves/filament-analytics-core": "^2.1",
        "jeffersongoncalves/laravel-pixel": "^3.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.21",
        "orchestra/testbench": "^9.0|^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "JeffersonGoncalves\\Filament\\Pixel\\": "src"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@php ./vendor/bin/testbench icons:cache",
            "@php ./vendor/bin/testbench package:discover --ansi"
        ],
        "analyse": "vendor/bin/phpstan analyse",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "JeffersonGoncalves\\Filament\\Pixel\\PixelServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
